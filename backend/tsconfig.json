{
  "compilerOptions": {
    /* Estructura de carpetas */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Entorno y Módulos */
    "target": "ES2022",
    "module": "CommonJS",
    "esModuleInterop": true,

    /* Verificación de tipos */
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "dist"]
}